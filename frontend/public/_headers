# Vite fingerprints everything under /assets/ with a content hash, so the URL changes
# whenever the bytes do. That makes it safe to tell browsers never to revalidate — which
# matters most for the 41.8 MB parking map: a repeat visit should cost zero network.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  # Clickjacking. Without this the site can be framed by any page on the internet, which on a
  # voting tool is the damaging case: an attacker frames /parking-vote invisibly under a decoy,
  # and a signed-in visitor's clicks land on real Support buttons. X-Frame-Options is the older
  # header and frame-ancestors the modern one; both are sent because old browsers ignore CSP
  # and some corporate proxies strip one or the other.
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://maps.googleapis.com; connect-src 'self' https://yiukmtgmsckuoehdnzfw.supabase.co wss://yiukmtgmsckuoehdnzfw.supabase.co https://nominatim.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

  # Stops a browser second-guessing a Content-Type. Chiefly matters for the 41.8 MB polygon
  # JSON: without it a browser is free to sniff a response into something executable.
  X-Content-Type-Options: nosniff

  # Every Street View thumbnail is a request to Google carrying a Referer. The default policy
  # would send the full URL, and map URLs identify the spot being looked at. Send the origin
  # only, and nothing at all when leaving HTTPS.
  Referrer-Policy: strict-origin-when-cross-origin

  # The app asks for none of these. Denying them means a future dependency cannot start
  # quietly asking on its own.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
