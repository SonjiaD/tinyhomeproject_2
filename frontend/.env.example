# Copy to .env.local for local development. The same three variables are set in the Netlify
# dashboard for production. Without them the app renders a blank page with no explanation,
# because createClient() is called with undefined values.

# Supabase project URL and public key.
# The anon key is NOT a secret: it ships inside the production JS bundle, where anyone can read
# it. Row Level Security is what decides what it can actually do — see
# supabase/migrations/20260830_02_enable_rls.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Street View Static API key, for the spot thumbnails in SitePanel and SuggestPage.
# Optional: without it those images fail to load and nothing else is affected.
VITE_GOOGLE_SV_KEY=your-street-view-key

# Note: there is no VITE_API_URL any more. The Flask backend was removed — the app talks to
# Supabase directly and loads its map data as a bundle asset.
#
# The admin scripts in data_pipeline/ are separate: they need SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY in a .env at the REPO ROOT, not here. That key bypasses RLS
# entirely, so it must never end up in a VITE_-prefixed variable, which would bundle it into
# the frontend and publish it.
